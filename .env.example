# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno del backend.
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL (Supabase en producción).
# Supabase → Project Settings → Database → Connection string → URI.
# Usa el driver asyncpg y exige SSL:
#   postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/brujulaj_db

# Modo debug: false en producción.
DEBUG=false

# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
SECRET_KEY=cambia_esto_en_produccion_usa_openssl_rand_hex_32

# Orígenes permitidos para CORS (separados por coma).
# En producción debe incluir el dominio del frontend en Vercel:
#   https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Clave de la API de Anthropic para el módulo de chat.
ANTHROPIC_API_KEY=

# Clave para cifrar datos sensibles en reposo (cédula). Cualquier cadena aleatoria.
# Genera una con: openssl rand -hex 32
# Si se deja vacía, se deriva de SECRET_KEY (aceptable solo en desarrollo).
ENCRYPTION_KEY=
